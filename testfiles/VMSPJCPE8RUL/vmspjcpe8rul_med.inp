*include, input=inc/material.inp

*section, name=section1, thickness=1.0, material=mat, type=plane
all

*job, name=fbar_job, domain=2d
*solver, solver=NISTParallelForMarmotElements, name=theSolver
**elementProperty, elSet=all, vms c_parameter=0.01

*fieldOutput
create=perNode, name=displacement, elSet=all, field=displacement, result=U,
create=perNode, name=pressure, elSet=all, field=pressure, result=U,
create=perNode, name=jacobi, elSet=all, field=jacobi, result=U,
create=perNode, name=umag, elSet=all, field=displacement, result=U, f(x)=' linalg.norm ( x, axis=1 )'
create=perNode, name=RF, nSet=gen_left, field=displacement, result=P, f(x)='sum(x[:,1])', saveHistory=True, export=rf_vmspjcpe8ul_med
create=perNode, name=U, nSet=gen_right, field=displacement, result=U, f(x)='mean(x[:,1])', saveHistory=True, export=u_vmspjcpe8ul_med
create=perElement, name=stress, elSet=all, result=stress, quadraturePoint=0:4, f(x)='np.mean( x, axis=1)'

*modelGenerator, generator=cooksmembrane, name=gen
x0=0, l=48
y0=0, h0=44, h1=16
elType=VMSPJCPE8RUL
nX=30
nY=20

*output, type=ensight, name=_vmspjcpe8ul_med
configuration, overwrite=True
create=perNode, fieldOutput=displacement,
create=perNode, fieldOutput=pressure,
create=perNode, fieldOutput=jacobi,
create=perElement, fieldOutput=stress

*include, input=inc/steps.inp
